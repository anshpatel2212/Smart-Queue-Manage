rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return hasRole('staff');
    }

    function isStaffOrAdmin() {
      return isStaff() || isAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Authenticated users can read user profiles (needed for student names on tokens/counters & staff profiles)
      allow read: if isAuthenticated();
      // Users can create their own initial profile strictly with role 'student' and status 'active', or admin
      allow create: if (isOwner(userId) && request.resource.data.role == 'student' && request.resource.data.status == 'active')
                    || isAdmin();
      // Users can update profile details, but CANNOT modify role, status, or uid
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'uid'])))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Departments Collection ---
    match /departments/{departmentId} {
      // Public / authenticated users can view active departments
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Services Collection ---
    match /services/{serviceId} {
      // Public / authenticated users can view campus services
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Queues Collection ---
    match /queues/{serviceId} {
      // Public / authenticated users can read queue state (current token, active counters)
      allow read: if true;
      // Atomic transactions by students (when joining) or staff/admin
      allow update: if isAuthenticated();
      allow create, delete: if isAdmin();
    }

    // --- Tokens Collection ---
    match /tokens/{tokenId} {
      // Students can read their own tokens, Staff and Admin can view all active tokens
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
      // Authenticated students can create their own token
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Students can cancel their own waiting token; Staff and Admin can advance token statuses
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.status == 'cancelled')
                    || isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- Queue History Collection ---
    match /queueHistory/{historyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
